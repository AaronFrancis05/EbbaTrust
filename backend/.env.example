# Copy to backend/.env and fill in. .env is gitignored and must never be committed.
# An agent never creates .env — that is a human step. AGENTS.md 5.2.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=debug

# mock | live
# "live" is not buildable yet: no MLHUD agreement, no national ID integration, no payments
# licence. Every provider stub throws. This value is the entire go-live migration.
ADAPTER_MODE=mock

# Supabase — the managed data layer behind this API (PLAN.md 3.1).
# The service-role key bypasses RLS. It lives here and in the Kubernetes secret, nowhere else.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
