# Copy to backend/.env and fill in. .env is gitignored and must never be committed.
# An agent never creates .env — that is a human step. AGENTS.md 5.2.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=debug

# mock | live
# "live" is not buildable yet: no MLHUD agreement, no national ID integration, no payments
# licence. Every provider stub throws. This value is the entire go-live migration.
ADAPTER_MODE=mock

# Postgres. Required — the service refuses to boot without it (Step 4).
# Locally, compose sets this to the db service and you do not need it here at all.
# This is the database the API *serves from*.
#
#   Direct connection (what a long-lived container should use):
#     postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres
#   Session pooler (same behaviour, use when the network has no IPv6):
#     postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Percent-encode the password: @ is %40, # is %23, / is %2F, : is %3A.
DATABASE_URL=
DATABASE_POOL_MAX=10

# The database `npm run db:migrate --remote` applies migrations to. Separate from
# DATABASE_URL on purpose: the account that serves traffic and the account that rewrites the
# schema are not the same job, and keeping them apart means a running service cannot migrate
# itself by accident. The runner reads this from here so no password is ever typed as a
# command argument, where `ps` and shell history would both keep it.
TARGET_DATABASE_URL=

# Pepper mixed into the NIN hash before it is stored (Step 5). Not a Supabase key and not
# rotatable without re-collecting every NIN — changing it invalidates every stored hash.
NIN_HASH_PEPPER=

# Supabase — the managed data layer behind this API (PLAN.md 3.1).
# The service-role key bypasses RLS. It lives here and in the Kubernetes secret, nowhere else.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
