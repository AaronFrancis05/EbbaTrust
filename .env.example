# EbbaTrust — mobile app environment variables
#
# Copy to `.env` and fill in. NEVER commit `.env` — it is gitignored.
# See AGENTS.md §5.2. The backend has its own file: backend/.env.example.

# --- Backend API ------------------------------------------------------------
# Where the app reaches the service that owns the rules (PLAN.md §3.1).
# Leave unset in local development and the client falls back to localhost:8080,
# or 10.0.2.2:8080 on the Android emulator, which cannot see the host's localhost.
EXPO_PUBLIC_API_URL=

# --- Supabase ---------------------------------------------------------------
# The app uses Supabase for AUTHENTICATION ONLY — phone OTP and session refresh.
# It issues no table queries; data comes from the backend API. AGENTS.md §4.1.
#
# The anon key is public by design: it is safe in the client bundle and is
# protected by Row Level Security. RLS is the security boundary, not the key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key bypasses RLS entirely. It belongs to backend/ alone —
# never in this file, never in any EXPO_PUBLIC_* variable, never in the bundle.

# --- Google Maps (Step 6) ---------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=

# Adapter selection moved to the backend in Step 3: see ADAPTER_MODE in
# backend/.env.example. Adapters carry API keys, and a secret shipped inside a
# mobile binary is a published secret. AGENTS.md §4.3.
